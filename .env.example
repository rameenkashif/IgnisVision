# Copy to .env and edit. The real .env is git-ignored. Never commit secrets.

# --- Public address -------------------------------------------------------
# Hostname or LAN IP Caddy serves on. "localhost" for this machine; use the
# machine's LAN IP (e.g. 192.168.1.20) to test the phone camera over Wi-Fi.
SITE_ADDRESS=localhost
# Origins allowed by CORS (JSON list). Must match how the browser reaches Caddy.
CORS_ORIGINS=["https://localhost"]

# --- Database -------------------------------------------------------------
POSTGRES_USER=ignis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ignis

# --- Backend --------------------------------------------------------------
ENVIRONMENT=prod
# Secret for signing access JWTs (Phase 1). Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# --- ML seam (HANDOFF §9) -------------------------------------------------
# mock = deterministic demo models (default); real = load weights below.
ML_BACKEND=mock
ML_DEVICE=cpu
ML_ALLOW_MOCK_FALLBACK=false
THERMAL_POSE_WEIGHTS=
SEGFORMER_WEIGHTS=
DAMAGE_SEG_WEIGHTS=
# Dev only: calm | escalating | collapse
MOCK_SCENARIO=calm

# --- LLM (HANDOFF §10, optional) -----------------------------------------
# template = no network, deterministic fallbacks. anthropic = Claude API.
LLM_PROVIDER=template
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=

# --- Text-to-speech -------------------------------------------------------
# browser = speechSynthesis in the client; server returns 501 for /tts.
TTS_PROVIDER=browser

# --- Backups --------------------------------------------------------------
BACKUP_RETENTION_DAYS=7
