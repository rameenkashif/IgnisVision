# Copy to .env and edit. The real .env is git-ignored. Never commit secrets.

# --- Public address -------------------------------------------------------
# Hostname or LAN IP Caddy serves on. "localhost" for this machine; use the
# machine's LAN IP (e.g. 192.168.1.20) to test the phone camera over Wi-Fi.
SITE_ADDRESS=localhost
# Origins allowed by CORS (JSON list). Must match how the browser reaches Caddy.
CORS_ORIGINS=["https://localhost"]

# --- Database -------------------------------------------------------------
POSTGRES_USER=ignis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ignis

# --- Backend --------------------------------------------------------------
ENVIRONMENT=prod
# Secret for signing access JWTs (Phase 1). Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Time zone for times printed in PDF reports
REPORT_TIMEZONE=Asia/Karachi

# --- ML seam (HANDOFF §9) -------------------------------------------------
# mock = deterministic demo models (default); real = load weights below.
ML_BACKEND=mock
ML_DEVICE=cpu
ML_ALLOW_MOCK_FALLBACK=false
THERMAL_POSE_WEIGHTS=
SEGFORMER_WEIGHTS=
DAMAGE_SEG_WEIGHTS=
# Mock storyline: calm | escalating | collapse (escalating/collapse are for demos and e2e tests)
MOCK_SCENARIO=calm
# Threads for model inference (never blocks the API event loop)
ML_WORKERS=4
# Where uploaded/captured media is stored inside the backend container (a Docker volume)
MEDIA_ROOT=/data/media

# --- LLM (HANDOFF §10, optional) -----------------------------------------
# template = no network, deterministic fallbacks. anthropic = Claude API (report narrative,
# trainer feedback, help assistant — each also needs its flag on in Admin → Settings).
LLM_PROVIDER=template
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=

# --- Text-to-speech -------------------------------------------------------
# browser = speechSynthesis in the client; server returns 501 for /tts.
TTS_PROVIDER=browser

# --- Backups --------------------------------------------------------------
BACKUP_RETENTION_DAYS=7
